# ---- The site (copy to .env.local for `npm run dev`; the same two go in GitHub repository variables) ----
# Both are public by design: they end up in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# ---- Database migrations only (drizzle-kit; never used by the site) ----
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ---- Secrets for the "api" Edge Function: set them in Supabase → Edge Functions → Secrets, not here ----
# GEMINI_API_KEY=            # used for Fix grammar / Ask when set (GEMINI_MODEL optional)
# ANTHROPIC_API_KEY=         # used when no Gemini key is set (CLAUDE_MODEL optional)
# TMDB_API_KEY=              # Japanese / Korean drama search
# STEAMGRIDDB_API_KEY=       # game covers
# GOOGLE_BOOKS_API_KEY=
# RAKUTEN_APPLICATION_ID=
# RAKUTEN_ACCESS_KEY=
